{
  "id": "/",
  "name": "SanZa — Games & Food Hub",
  "short_name": "SanZa",
  "description": "One SanZa. One Family. Play SanZa Games, explore SanZa Food Hub and discover offers.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#080808",
  "theme_color": "#080808",
  "categories": [
    "games",
    "food",
    "entertainment"
  ],
  "icons": [
    {
      "src": "/app-icon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/sanza-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "prefer_related_applications": false
}
